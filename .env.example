# Optional. Linear API key from https://linear.app/settings/api
LINEAR_API_KEY=
# Optional. Notion internal integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=
# Optional. Comma-separated local directories to scan for git repos, e.g. /Users/me/dev,/Users/me/work
SCAN_DIRS=
# Dashboard port (default 3131)
PORT=3131
# Minutes between automatic syncs (default 15)
SYNC_INTERVAL_MINUTES=15
